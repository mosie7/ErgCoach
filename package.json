{
  "name": "ergcoach",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @ergcoach/web dev",
    "dev:web": "pnpm --filter @ergcoach/web dev",
    "dev:mcp": "pnpm --filter @ergcoach/mcp-server dev",
    "build": "pnpm -r --filter=!@ergcoach/mcp-server build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ergcoach/database generate",
    "db:migrate": "pnpm --filter @ergcoach/database migrate",
    "db:migrate:dev": "pnpm --filter @ergcoach/database migrate:dev",
    "db:seed": "pnpm --filter @ergcoach/database seed",
    "db:studio": "pnpm --filter @ergcoach/database studio",
    "db:reset": "pnpm --filter @ergcoach/database reset",
    "db:analyse": "pnpm --filter @ergcoach/services exec tsx src/analyse-all.ts",
    "docker:build": "docker build -t ergcoach-web:latest .",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
