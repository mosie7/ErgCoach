{
  "name": "@ergcoach/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts || true",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ergcoach/ai-coach": "workspace:*",
    "@ergcoach/concept2": "workspace:*",
    "@ergcoach/database": "workspace:*",
    "@ergcoach/shared": "workspace:*",
    "@ergcoach/training-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "@types/node": "^22.13.10"
  }
}
