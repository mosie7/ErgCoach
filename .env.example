# Database
DATABASE_URL="postgresql://ergcoach:ergcoach@localhost:5432/ergcoach?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="change-me-to-a-long-random-string"

# OpenAI (server-side — used for Pro subscribers)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Concept2 Logbook API (per-user OAuth)
# Register an app at https://log.concept2.com/developers
CONCEPT2_CLIENT_ID=""
CONCEPT2_CLIENT_SECRET=""
CONCEPT2_REDIRECT_URI="http://localhost:3000/api/concept2/callback"
CONCEPT2_AUTH_URL="https://log.concept2.com/oauth/authorize"
CONCEPT2_TOKEN_URL="https://log.concept2.com/oauth/access_token"
CONCEPT2_API_BASE_URL="https://log.concept2.com/api"
# Leave unset/false for live OAuth when CLIENT_ID/SECRET are set.
# Set true only if you intentionally want mock fixtures.
CONCEPT2_USE_MOCK="false"

# Billing / Stripe
BILLING_ENABLED="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_TRIAL_DAYS=""
